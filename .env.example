# Copy to .env.local (git-ignored). Only the anon/publishable key ends up in the browser build.
VITE_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
VITE_SUPABASE_ANON_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxx

# Μόνο για τα τοπικά scripts εισαγωγής (scripts/push-news.mjs) — ΠΟΤΕ στον browser, ποτέ σε commit.
# Supabase → Project Settings → API → service_role (secret)
SUPABASE_SERVICE_ROLE_KEY=
